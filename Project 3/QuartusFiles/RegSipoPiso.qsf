set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to Dis4[6]

set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to Dis5[0]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to Dis5[1]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to Dis5[2]
